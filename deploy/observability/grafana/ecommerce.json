{
  "uid": "ecommerce-operations",
  "title": "E-commerce Operations",
  "tags": ["ecommerce", "portfolio"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {"from": "now-30m", "to": "now"},
  "links": [
    {"title": "Runbook", "type": "link", "url": "https://github.com/Deepika-1201/ecommerce-order-system/blob/main/docs/portfolio-runbook.md", "targetBlank": true},
    {"title": "Prometheus Alerts", "type": "link", "url": "http://localhost:9090/alerts", "targetBlank": true}
  ],
  "panels": [
    {
      "id": 1, "title": "Scrape Health", "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [{"refId": "A", "expr": "min(up{job=\"ecommerce\"})", "instant": true}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2, "title": "Orders Past Deadline", "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [{"refId": "A", "expr": "max(ecom_orders_overdue{job=\"ecommerce\"})", "instant": true}],
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3, "title": "Pending Email", "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [{"refId": "A", "expr": "max(ecom_notifications_current{job=\"ecommerce\",status=\"PENDING\"})", "instant": true}],
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 4, "title": "Failed Email", "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [{"refId": "A", "expr": "max(ecom_notifications_current{job=\"ecommerce\",status=\"FAILED\"})", "instant": true}],
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 5, "title": "Outbox Backlog", "type": "timeseries",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [
        {"refId": "A", "expr": "max by (channel) (ecom_outbox_pending{job=\"ecommerce\"})", "legendFormat": "{{channel}} pending"},
        {"refId": "B", "expr": "max by (channel) (ecom_outbox_parked{job=\"ecommerce\"})", "legendFormat": "{{channel}} parked"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 6, "title": "Oldest Pending Work", "type": "timeseries",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [
        {"refId": "A", "expr": "max by (channel) (ecom_outbox_oldest_age_seconds{job=\"ecommerce\"})", "legendFormat": "outbox {{channel}}"},
        {"refId": "B", "expr": "max(ecom_tasks_oldest_due_age_seconds{job=\"ecommerce\"})", "legendFormat": "due tasks"},
        {"refId": "C", "expr": "max(ecom_notifications_oldest_pending_age_seconds{job=\"ecommerce\"})", "legendFormat": "email"},
        {"refId": "D", "expr": "max(ecom_orders_oldest_overdue_age_seconds{job=\"ecommerce\"})", "legendFormat": "overdue order"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 7, "title": "Current Order States", "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [{"refId": "A", "expr": "max by (status) (ecom_orders_current{job=\"ecommerce\"})", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 8, "title": "Task States", "type": "timeseries",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [{"refId": "A", "expr": "max by (status) (ecom_tasks_current{job=\"ecommerce\"})", "legendFormat": "{{status}}"}],
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 9, "title": "API Request Rate", "type": "timeseries",
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"ecommerce\",uri=~\"/v1/.*\"}[5m]))", "legendFormat": "HTTP {{status}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 10, "title": "API Latency p95", "type": "timeseries",
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"ecommerce\",uri=~\"/v1/.*\"}[5m])))", "legendFormat": "p95"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 11, "title": "Kafka Recovery Activity", "type": "timeseries",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (consumer) (increase(ecom_kafka_deadletters_published_total{job=\"ecommerce\"}[5m]))", "legendFormat": "{{consumer}} DLT published"},
        {"refId": "B", "expr": "sum by (consumer) (increase(ecom_kafka_deadletters_failures_total{job=\"ecommerce\"}[5m]))", "legendFormat": "{{consumer}} DLT failed"}
      ],
      "fieldConfig": {"defaults": {"min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 12, "title": "Database Pool", "type": "timeseries",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ecommerce-prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(hikaricp_connections_active{job=\"ecommerce\"})", "legendFormat": "active"},
        {"refId": "B", "expr": "sum(hikaricp_connections_pending{job=\"ecommerce\"})", "legendFormat": "waiting"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    }
  ]
}